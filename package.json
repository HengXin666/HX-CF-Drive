{
  "name": "hx-cf-drive",
  "version": "0.3.0",
  "private": true,
  "description": "全部运行在 Cloudflare 上的 Telegram 网盘网关 (Workers + D1, 不用 R2)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hx-cf-drive --local",
    "db:migrate": "wrangler d1 migrations apply hx-cf-drive --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "quota": "node scripts/quota.mjs",
    "meter": "node scripts/meter.mjs",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  },
  "license": "MIT"
}
